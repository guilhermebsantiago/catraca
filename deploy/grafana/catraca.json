{
  "title": "Catraca",
  "uid": "catraca",
  "description": "Catraca's objectives and the metrics behind them. Needs the recording rules of deploy/prometheus/rules.yaml; see docs/slo.md.",
  "tags": ["catraca"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(catraca_build_info, job)", "refId": "job"},
        "definition": "label_values(catraca_build_info, job)",
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "row", "title": "Objectives", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {
      "id": 2, "type": "stat", "title": "Error budget left, 30 days",
      "description": "The share of each objective's error budget not spent over the last 30 days. Below 0, the objective is missed.",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "catraca:slo_error_budget_remaining:ratio30d{job=\"$job\"}", "legendFormat": "{{slo}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0}, {"color": "green", "value": 0.25}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical"}
    },
    {
      "id": 3, "type": "timeseries", "title": "Burn rate, 1 hour",
      "description": "How fast each budget burns: 1 spends it in exactly 30 days. The fast page fires past 14.4 (with the last 5 minutes), the slow one past 6 over 6 hours.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "catraca:slo_errors:ratio_rate1h{job=\"$job\"} / on (slo) group_left () (1 - catraca:slo_objective:ratio)", "legendFormat": "{{slo}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 6}, {"color": "red", "value": 14.4}]}}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "Error ratio, 5 minutes",
      "description": "The share of each SLI's events that failed it: 5xx decisions, decisions slower than 25 ms, degraded decisions, feedback not counted, late or dead webhooks, decisions left out of the audit log.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "catraca:slo_errors:ratio_rate5m{job=\"$job\"}", "legendFormat": "{{slo}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}
    },

    {"id": 10, "type": "row", "title": "Decisions", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "panels": []},
    {
      "id": 11, "type": "timeseries", "title": "Decisions by action",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (action) (rate(catraca_decisions_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "{{action}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 12, "type": "timeseries", "title": "Degraded and shed",
      "description": "Decisions made without some signals, and the part admission control shed without calling the store.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(catraca_degraded_decisions_total{job=\"$job\"}[$__rate_interval])) / sum(rate(catraca_decisions_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "degraded"},
        {"refId": "B", "expr": "sum(rate(catraca_admission_shed_total{job=\"$job\", route=~\"POST /v1/(decide|events)\"}[$__rate_interval])) / sum(rate(catraca_decisions_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "shed"},
        {"refId": "C", "expr": "sum(rate(catraca_short_circuited_decisions_total{job=\"$job\"}[$__rate_interval])) / sum(rate(catraca_decisions_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "breaker open"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "POST /v1/decide latency",
      "description": "As the server measures it. With tracing on, the dots are exemplars: the trace of a request in that bucket.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(catraca_http_request_duration_seconds_bucket{job=\"$job\", route=\"POST /v1/decide\"}[$__rate_interval])))", "legendFormat": "p99", "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.5, sum by (le) (rate(catraca_http_request_duration_seconds_bucket{job=\"$job\", route=\"POST /v1/decide\"}[$__rate_interval])))", "legendFormat": "p50"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Admission",
      "description": "The adaptive decision limit, the decisions in flight, and the requests shed for want of a slot.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(catraca_admission_limit{job=\"$job\", group=\"decisions\"})", "legendFormat": "limit"},
        {"refId": "B", "expr": "sum(catraca_admission_inflight{job=\"$job\", route=~\"POST /v1/(decide|events)\"})", "legendFormat": "in flight"},
        {"refId": "C", "expr": "sum by (route) (rate(catraca_admission_shed_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "shed {{route}}/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 15, "type": "timeseries", "title": "Engine decision time",
      "description": "From validation to the combined action: the store call, the rules and the outbox write of effects.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(catraca_decision_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99", "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.5, sum by (le) (rate(catraca_decision_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p50"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },

    {"id": 20, "type": "row", "title": "Store", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "panels": []},
    {
      "id": 21, "type": "timeseries", "title": "Store call time",
      "description": "Calls that answered. A call is cut at engine.deadline, 10 ms by default.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (call, le) (rate(catraca_store_call_duration_seconds_bucket{job=\"$job\", result=\"ok\"}[$__rate_interval])))", "legendFormat": "p99 {{call}}", "exemplar": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 22, "type": "timeseries", "title": "Store calls by result",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (call, result) (rate(catraca_store_call_duration_seconds_count{job=\"$job\"}[$__rate_interval]))", "legendFormat": "{{call}} {{result}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 23, "type": "timeseries", "title": "Breaker and dependencies",
      "description": "1 while the breaker is in a state, and while a dependency's last check passed on every instance.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "max by (state) (catraca_store_breaker_state{job=\"$job\", state!=\"closed\"})", "legendFormat": "breaker {{state}}"},
        {"refId": "B", "expr": "min by (dependency) (catraca_dependency_up{job=\"$job\"})", "legendFormat": "{{dependency}} up"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []}
    },

    {"id": 30, "type": "row", "title": "Effects", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40}, "panels": []},
    {
      "id": 31, "type": "timeseries", "title": "Webhook attempts",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 41},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (hook, outcome) (rate(catraca_hooks_attempts_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "{{hook}} {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 32, "type": "timeseries", "title": "Webhook delivery latency",
      "description": "From queued to a 2xx, retries included. The freshness objective counts those within 60 s.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 41},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.99, sum by (hook, le) (rate(catraca_hooks_delivery_latency_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99 {{hook}}", "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (hook, le) (rate(catraca_hooks_attempt_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99 request {{hook}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 33, "type": "timeseries", "title": "Outbox backlog",
      "description": "Every instance counts the whole outbox, so these are maxima.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 41},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "max by (hook) (catraca_hooks_oldest_pending_age_seconds{job=\"$job\"})", "legendFormat": "oldest {{hook}}"},
        {"refId": "B", "expr": "max by (hook) (catraca_hooks_pending{job=\"$job\"})", "legendFormat": "pending {{hook}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byRegexp", "options": "oldest.*"}, "properties": [{"id": "unit", "value": "s"}]}]}
    },

    {"id": 40, "type": "row", "title": "Audit log", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 49}, "panels": []},
    {
      "id": 41, "type": "timeseries", "title": "Batch write time",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 50},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (result, le) (rate(catraca_audit_write_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99 {{result}}", "exemplar": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 42, "type": "timeseries", "title": "Decisions queued",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 50},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (instance) (catraca_audit_queued{job=\"$job\"})", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 43, "type": "timeseries", "title": "Decisions lost",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 50},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(catraca_records_dropped_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "dropped by the engine"},
        {"refId": "B", "expr": "sum(rate(catraca_audit_dropped_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "dropped by the audit log"},
        {"refId": "C", "expr": "sum(rate(catraca_audit_failed_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "failed"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },

    {"id": 50, "type": "row", "title": "Leaked keys", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 58}, "panels": []},
    {
      "id": 51, "type": "timeseries", "title": "Reports waiting",
      "description": "Read from the shared queue: the same on every instance.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 59},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "max by (status) (catraca_secret_scanning_reports{job=\"$job\"})", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 52, "type": "timeseries", "title": "Oldest pending report",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 59},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "max(catraca_secret_scanning_oldest_pending_seconds{job=\"$job\"})", "legendFormat": "oldest"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 53, "type": "timeseries", "title": "Report processing time",
      "description": "From queued to done or given up. The objective counts those done within 5 minutes.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 59},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(catraca_secret_scanning_report_latency_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99 report", "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(catraca_secret_scanning_attempt_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "p99 attempt"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ]
}
